{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        },
        {
            "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/.netlify/functions/send-quote",
            "destination": "/api/send-quote"
        },
        {
            "source": "/windows",
            "destination": "/index.html"
        },
        {
            "source": "/detailing",
            "destination": "/index.html"
        },
        {
            "source": "/quote",
            "destination": "/quote.html"
        },
        {
            "source": "/services",
            "destination": "/services.html"
        },
        {
            "source": "/services/exterior-window-cleaning",
            "destination": "/exterior-window-cleaning.html"
        },
        {
            "source": "/services/interior-window-cleaning",
            "destination": "/interior-window-cleaning.html"
        },
        {
            "source": "/services/screen-cleaning",
            "destination": "/screen-cleaning.html"
        },
        {
            "source": "/services/skylight-washing",
            "destination": "/skylight-washing.html"
        },
        {
            "source": "/services/track-detailing",
            "destination": "/track-detailing.html"
        },
        {
            "source": "/services/commercial-cleaning",
            "destination": "/commercial-cleaning.html"
        },
        {
            "source": "/services/exterior-detail",
            "destination": "/exterior-detail.html"
        },
        {
            "source": "/services/interior-detail",
            "destination": "/interior-detail.html"
        },
        {
            "source": "/services/pet-hair-removal",
            "destination": "/pet-hair-removal.html"
        },
        {
            "source": "/services/spray-wax",
            "destination": "/spray-wax.html"
        },
        {
            "source": "/services/floormat-restoration",
            "destination": "/floormat-restoration.html"
        },
        {
            "source": "/services/clay-bar-treatment",
            "destination": "/clay-bar-treatment.html"
        },
        {
            "source": "/privacy-policy",
            "destination": "/privacy-policy.html"
        },
        {
            "source": "/terms-of-service",
            "destination": "/terms-of-service.html"
        },
        {
            "source": "/service-areas",
            "destination": "/service-areas.html"
        },
        {
            "source": "/hanover-nh",
            "destination": "/hanover-nh.html"
        },
        {
            "source": "/lebanon-nh",
            "destination": "/lebanon-nh.html"
        },
        {
            "source": "/woodstock-vt",
            "destination": "/woodstock-vt.html"
        },
        {
            "source": "/norwich-vt",
            "destination": "/norwich-vt.html"
        },
        {
            "source": "/hartford-vt",
            "destination": "/hartford-vt.html"
        },
        {
            "source": "/fairlee-vt",
            "destination": "/fairlee-vt.html"
        },
        {
            "source": "/quechee-vt",
            "destination": "/quechee-vt.html"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ]
}